# Prepend this repo's kernelspecs to Jupyter's search path.
#
# The system sagemath kernelspec launches `python -m sage.repl.ipython_kernel`
# with a bare `python`, resolved from the launching process's PATH.  Any
# Jupyter server started under this project's .venv therefore gets
# .venv/bin/python, which cannot import sage: the kernel crash-loops five
# times and the websocket handshake fails with a bare 500 a minute later.
#
# dev/jupyter/kernels/sagemath uses `sage --python`, which resolves Sage's own
# interpreter regardless of the launching environment.  JUPYTER_PATH entries
# take precedence over the user and sys.prefix data directories, so this
# shadows the system spec for anything launched from this repo — including the
# `jupyter lab` subprocesses spawned by the test suite, which inherit os.environ.
export JUPYTER_PATH="$PWD/dev/jupyter${JUPYTER_PATH:+:$JUPYTER_PATH}"
