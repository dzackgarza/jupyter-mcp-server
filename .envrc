# Generate a development-only sagemath kernelspec with Sage's actual Python.
# A bare python would be replaced by the Jupyter server's own interpreter;
# sage --python was removed in Sage 10.10. Keep the path local to this checkout.
sage_kernel_path="$(python3 "$PWD/dev/configure_sage_kernel.py")" || return 1
export JUPYTER_PATH="$sage_kernel_path${JUPYTER_PATH:+:$JUPYTER_PATH}"
export JUPYTER_MCP_TEST_SAGE=1
unset sage_kernel_path
