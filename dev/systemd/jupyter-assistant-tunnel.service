[Unit]
Description=Cloudflare tunnel for jupyter-assistant.dzackgarza.com
After=network-online.target jupyter-assistant-api.service
Wants=network-online.target jupyter-assistant-api.service

[Service]
# The config is vendored (dev/cloudflared/) so the ingress port, IPv4 pinning, and
# http2 protocol are versioned rather than surviving only in an untracked dotfile.
# Only the credentials JSON stays in ~/.cloudflared — the config references it by
# path, so no secret enters the repo.
ExecStart=/bin/cloudflared tunnel --config %h/research/subrepos/jupyter-assistant-api/dev/cloudflared/config-jupyter-assistant.yml run
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
